{
  "name": "backend-core",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start --watch",
    "test": "jest",
    "generate-swagger": "GENERATE_SWAGGER=true nest start && npx prettier swagger.json --write && ng-openapi-gen --input swagger.json --output ../frontend-app/src/app/api/backend-core && npx prettier ../frontend-app/src/app/api/backend-core --write"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "body-parser": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mongoose": "^8.20.1",
    "nodemailer": "^8.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@kominal/ng-openapi-gen": "^0.53.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.5",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.10.1",
    "@types/uuid": "^11.0.0",
    "jest": "30.2.0",
    "mongodb-memory-server": "^10.2.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!uuid/)"
    ],
    "moduleNameMapper": {
      "^@nestjs/(common|core|mongoose|swagger)$": "<rootDir>/../node_modules/@nestjs/$1",
      "^@nestjs/(common|core|mongoose|swagger)/(.*)$": "<rootDir>/../node_modules/@nestjs/$1/$2",
      "^(mongoose|class-validator|class-transformer)$": "<rootDir>/../node_modules/$1",
      "^@kominal/common-nestjs$": "<rootDir>/../../../../common/nestjs/src/index.ts",
      "^@kominal/common-nestjs/(.*)$": "<rootDir>/../../../../common/nestjs/src/$1",
      "^@entities/(.*)$": "<rootDir>/entities/$1",
      "^@helpers/(.*)$": "<rootDir>/helpers/$1",
      "^@middlewares/(.*)$": "<rootDir>/middlewares/$1",
      "^@models/(.*)$": "<rootDir>/models/$1",
      "^@services/(.*)$": "<rootDir>/services/$1",
      "^@guards/(.*)$": "<rootDir>/guards/$1",
      "^@controllers/(.*)$": "<rootDir>/controllers/$1",
      "^@entity-services/(.*)$": "<rootDir>/entity-services/$1"
    },
    "testEnvironment": "node",
    "testTimeout": 120000
  }
}

{
  "folders": [
    { "name": "Trackify", "path": "." },
    { "name": "Backend Core", "path": "backend-core" },
    { "name": "Frontend App", "path": "frontend-app" },
    { "name": "Platform", "path": "platform" },
    { "name": "GitHub Actions", "path": ".github/workflows" },
  ],
  "settings": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.suggestSelection": "first",
    "editor.inlineSuggest.enabled": true,
    "editor.rulers": [180, 300],
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": false,
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "debug.console.acceptSuggestionOnEnter": "on",
    "typescript.tsserver.log": "off",
    "javascript.suggest.enabled": false,
    "git.confirmSync": false,
    "files.eol": "\n",
    "files.exclude": {
      "**/node_modules": true,
      "**/api": true,
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
      },
      "typescript.preferences.importModuleSpecifier": "non-relative",
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[scss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
  },
  "extensions": {
    "recommendations": ["angular.ng-template", "dbaeumer.vscode-eslint", "eamodio.gitlens", "esbenp.prettier-vscode"],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "ng serve",
        "type": "chrome",
        "request": "launch",
        "preLaunchTask": "npm: start",
        "url": "http://localhost:4200/",
      },
    ],
    "compounds": [],
  },
}
